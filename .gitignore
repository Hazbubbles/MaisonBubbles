# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Scripts et exports Axonaut (données clients/fournisseurs) : ne doivent
# jamais être publiés — tout ce qui est dans public/ est téléchargeable
# publiquement sur le site.
/public/skills

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
